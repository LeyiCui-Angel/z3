; push/pop forces the incremental (smt core) solver path, which relies on the
; th_rewriter reduction rather than the elim-dates tactic.
; expect: sat, unsat, sat, unsat, sat
(declare-const d Date)
(declare-const e Date)
(assert (= d (date.mk 2026 7 7)))
(check-sat)
(push)
(assert (= (date.dow d) 3))
(check-sat)
(pop)
(push)
(assert (date.lt d e))
(assert (date.le e (date.mk 2026 12 31)))
(check-sat)
(pop)
(push)
(assert (= (date.to_days e) (date.to_days d)))
(assert (not (= e d)))
(check-sat)
(pop)
(assert (= e (date.add_days d 365)))
(check-sat)
(get-value ((date.year e) (date.month e) (date.day e)))
