; month length boundaries, all twelve months
(declare-const d Date)
(push)
(assert (or (= d (date.mk 2001 1 31)) (= d (date.mk 2001 3 31))
            (= d (date.mk 2001 5 31)) (= d (date.mk 2001 7 31))
            (= d (date.mk 2001 8 31)) (= d (date.mk 2001 10 31))
            (= d (date.mk 2001 12 31))
            (= d (date.mk 2001 4 30)) (= d (date.mk 2001 6 30))
            (= d (date.mk 2001 9 30)) (= d (date.mk 2001 11 30))
            (= d (date.mk 2001 2 28))))
(check-sat)
; EXPECT: sat (all last days of months are valid)
(pop)
(declare-const m Int)
(declare-const e Date)
(assert (= e (date.mk 2001 m 31)))
(check-sat)
(get-value (m))
; EXPECT: sat, m in {1,3,5,7,8,10,12}
(push)
(assert (or (= m 4) (= m 6) (= m 9) (= m 11) (= m 2)))
(check-sat)
; EXPECT: unsat (short months have no 31st)
(pop)
