; basic parsing, selectors, models
; EXPECT: sat ((y 2000) (m 2) (dd 29))
(declare-const d Date)
(declare-const y Int)
(declare-const m Int)
(declare-const dd Int)
(assert (= d (date.mk 2000 2 29)))
(assert (= y (date.year d)))
(assert (= m (date.month d)))
(assert (= dd (date.day d)))
(check-sat)
(get-value (y m dd))
